{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshfixer.dev/schema/operation.schema.json",
  "title": "MeshFixer operation spec (MF-SPEC-001)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "summary", "geometry_kinds", "target", "parameters", "effects", "runtime"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "geometry_kinds": { "type": "array", "items": { "enum": ["mesh"] }, "minItems": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whole_object", "kinds"],
      "properties": {
        "whole_object": { "type": "boolean" },
        "kinds": { "type": "array", "items": { "enum": ["face_set", "component", "boundary_loop"] } }
      }
    },
    "operands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "kinds", "required"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "role": { "enum": ["read", "consumed", "kept"] },
          "kinds": {
            "type": "array",
            "items": { "enum": ["object", "face_set", "component"] },
            "minItems": 1
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "default", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["integer", "float", "bool", "choice", "vec3", "affine", "samples", "faces", "text"] },
          "default": {
            "$comment": "A vec3 default has 3 numbers and an affine default has 12 (row-major 3x4: the 3x3 linear part, then translation). The schema only checks that array elements are numbers; the exact element count per type is enforced in Rust deserialization (mf-spec::model::Scalar::as_f64_array, TryFrom<RawParam> for ParamSpec), which rejects a wrong count by name.",
            "type": ["number", "boolean", "string", "array"],
            "items": { "type": "number" }
          },
          "values": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "minItems": 2, "uniqueItems": true },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "unit": { "type": "string" },
          "default_from": { "type": "string", "pattern": "^fit\\.[a-z_]+$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "postconditions": { "type": "array", "items": { "type": "string" } },
    "effects": { "type": "array", "items": { "enum": ["read_only", "geometry_changes", "topology_changes", "renumbers_elements", "transform_changes", "removes_objects", "creates_objects"] } },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellable", "progress"],
      "properties": {
        "cancellable": { "type": "boolean" },
        "progress": { "type": "boolean" }
      }
    }
  }
}
